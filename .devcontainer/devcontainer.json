{
	"image": "mcr.microsoft.com/devcontainers/go:1.25",
	"features": {
		"ghcr.io/devcontainers/features/sshd:1": {}
		"ghcr.io/devcontainers/features/github-cli:1": {}
  			"version": "1.1",
         		"tflint": "latest"
	},
	"remoteUser": "vscode",
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go"
			],
			"settings": {
				"go.toolsManagement.checkForUpdates": "local",
				"go.useLanguageServer": true,
				"go.gopath": "/go"
			}
		}
	},
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined"
	]
}
